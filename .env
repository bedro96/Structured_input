# Azure AI Foundry Project endpoint
# Found in the Overview page of your Microsoft Foundry portal
# Format: https://<your-ai-services-account>.services.ai.azure.com/api/projects/<your-project-name>
AZURE_AI_PROJECT_ENDPOINT="https://eus2-project-kuko.services.ai.azure.com/api/projects/chat-project"

# Deployment name of the AI model in your Foundry Project
# Found under "Build" > "Models" (first column of the "Deployments" table)
AZURE_AI_MODEL_DEPLOYMENT_NAME=gpt-5.4
# Name of the Azure AI Foundry agent to create or reuse

# Name of the Azure AI Foundry agent to create or reuse
AZURE_AI_AGENT_NAME="structured-input-agent-01"
# API server configuration
API_HOST=localhost
API_PORT=8080

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=DEBUG

# MCP Server connection name (used to identify the MCP Server in Azure AI Foundry)
MCP_SERVER_LABEL="Connection_to_email_MCP_Server"
MCP_SERVER_URL="https://email-send-mcp.victoriousdune-f6c83ffa.koreacentral.azurecontainerapps.io/mcp"
MCP_REQUIRE_APPROVAL="never"
MCP_SERVER_CONNECTION_NAME="kakao_email_sending_mcp" 

