# Azure AI Foundry Project endpoint
# Found in the Overview page of your Microsoft Foundry portal
# Format: https://<your-ai-services-account>.services.ai.azure.com/api/projects/<your-project-name>
AZURE_AI_PROJECT_ENDPOINT=https://your-account.services.ai.azure.com/api/projects/your-project

# Deployment name of the AI model in your Foundry Project
# Found under "Build" > "Models" (first column of the "Deployments" table)
AZURE_AI_MODEL_DEPLOYMENT_NAME=gpt-4o

# MCP Server configuration (used when running the local FastMCP HTTP server)
MCP_SERVER_HOST=localhost
MCP_SERVER_PORT=8000

# API server configuration
API_HOST=localhost
API_PORT=8080

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=DEBUG
